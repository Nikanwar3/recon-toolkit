# Copy to .env and fill in real values locally. Never commit the real .env.
# main.py does not auto-load this file; it's documentation for which
# environment variables `--db-backend oracle` reads (see docs/oracle-setup.md).

# Oracle connection (required only for --db-backend oracle)
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_USER=recon_app
ORACLE_PASSWORD=change-me
